{
  "initial": "idle",
  "states": {
    "idle": { "on": { "SUBMIT": "working" } },
    "working": {
      "initial": "creating",
      "on": { "CANCEL": "idle" },
      "states": {
        "creating": { "on": { "CREATED": "waiting", "CREATE_FAILED": "failed" } },
        "waiting": { "on": { "POLL_OK": "done", "POLL_FAIL": "failed" } },
        "failed": { "on": { "RETRY": "creating" } }
      }
    },
    "done": {}
  }
}
